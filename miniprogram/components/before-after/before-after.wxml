<!-- components/before-after/before-after.wxml -->
<view
  class="ba"
  bindtouchstart="onStart"
  bindtouchmove="onMove"
  bindtouchend="onEnd"
  bindtouchcancel="onEnd"
  bindtap="onTap"
>
  <!-- 底层：完成品 -->
  <image class="ba-layer" src="{{after}}" mode="aspectFill" />

  <!-- 上层：素体，按百分比裁切 -->
  <view class="ba-clip" style="width: {{pos}}%;">
    <image
      class="ba-layer ba-layer--strip"
      src="{{before}}"
      mode="aspectFill"
      style="width: {{stripWidth}}px;"
    />
  </view>

  <!-- 分割线 -->
  <view class="ba-line {{dragging ? 'ba-line--active' : ''}}" style="left: {{pos}}%;">
    <view class="ba-handle">
      <text class="ba-arrow">‹</text>
      <text class="ba-arrow">›</text>
    </view>
  </view>

  <!-- 角标 -->
  <view class="ba-tag ba-tag--left">素体</view>
  <view class="ba-tag ba-tag--right">完成品</view>
</view>
