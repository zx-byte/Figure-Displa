/* components/before-after/before-after.wxss */

.ba {
  position: relative;
  width: 100%;
  height: 750rpx;
  overflow: hidden;
  background-color: #1A1A24;
}

.ba-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 裁切层：宽度由拖动控制，内部图片保持整体宽度不变 */
.ba-clip {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  overflow: hidden;
}

.ba-layer--strip {
  width: 750rpx;
  max-width: none;
}

/* 分割线 */
.ba-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  margin-left: -1rpx;
  background-color: rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 12rpx rgba(0, 0, 0, 0.35);
}

.ba-line--active {
  background-color: #FF5C39;
}

.ba-handle {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.28);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.ba-arrow {
  font-size: 26rpx;
  color: #1A1A24;
  line-height: 1;
  margin: 0 -2rpx;
}

/* 角标 */
.ba-tag {
  position: absolute;
  bottom: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background-color: rgba(20, 20, 26, 0.62);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1rpx;
}

.ba-tag--left {
  left: 24rpx;
}

.ba-tag--right {
  right: 24rpx;
}
