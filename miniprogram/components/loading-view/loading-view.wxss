/* components/loading-view/loading-view.wxss */

.skeleton {
  background: linear-gradient(90deg, #EDEDF2 25%, #F7F7FA 37%, #EDEDF2 63%);
  background-size: 400% 100%;
  animation: sk-loading 1.4s ease infinite;
  border-radius: 12rpx;
}

@keyframes sk-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.skeleton-wrap {
  padding: 24rpx;
}

/* 两列网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-item {
  width: 48%;
  margin-bottom: 24rpx;
}

.block-thumb {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
}

/* 首页：轮播 + 快捷入口 + 网格 */
.block-banner {
  width: 100%;
  height: 480rpx;
  margin-bottom: 28rpx;
  border-radius: 24rpx;
}

.entry-row-skeleton {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.entry-col-skeleton {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 22%;
}

.block-dot {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.block-line--tiny {
  width: 72%;
  height: 22rpx;
  margin-top: 14rpx;
}

/* 单列列表 */
.row {
  display: flex;
  flex-direction: row;
  margin-bottom: 24rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
}

.block-cover {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.row-body {
  flex: 1;
  padding-left: 20rpx;
}

/* 详情 */
.block-hero {
  width: 100%;
  height: 620rpx;
  border-radius: 0;
}

.detail-body {
  padding: 32rpx 24rpx;
}

/* 通用行 */
.block-line {
  height: 26rpx;
  margin-top: 18rpx;
}

.block-line--long {
  width: 86%;
}

.block-line--mid {
  width: 58%;
}

.block-line--short {
  width: 32%;
}
