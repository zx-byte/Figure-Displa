/* components/privacy-modal/privacy-modal.wxss */

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(26, 26, 36, 0.55);
}

.card {
  width: 600rpx;
  padding: 44rpx 40rpx 36rpx;
  background-color: var(--color-card);
  border-radius: 28rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 24rpx;
}

.desc {
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--color-ink-2);
}

.link {
  color: var(--color-brand);
}

.points {
  margin: 28rpx 0 8rpx;
  padding: 24rpx 26rpx;
  background-color: var(--color-bg);
  border-radius: var(--radius-md);
}

.point {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.point:last-child {
  margin-bottom: 0;
}

.point-dot {
  flex-shrink: 0;
  width: 8rpx;
  height: 8rpx;
  margin: 15rpx 14rpx 0 0;
  border-radius: 50%;
  background-color: var(--color-brand);
}

.point-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--color-sub);
}

.actions {
  display: flex;
  margin-top: 36rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 29rpx;
  border-radius: 44rpx;
}

.btn--ghost {
  margin-right: 20rpx;
  color: var(--color-sub);
  background-color: var(--color-bg);
}

.btn--primary {
  color: #FFFFFF;
  font-weight: 600;
  background-color: var(--color-brand);
}

.btn--hover {
  background-color: #EDEDF2;
}

.btn--primary-hover {
  background-color: var(--color-brand-dark);
}
