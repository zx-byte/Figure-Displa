/* components/panorama/panorama.wxss */

.panorama {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #14141A;
}

.pano-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 首屏操作提示 */
.pano-hint {
  position: absolute;
  left: 50%;
  bottom: 96rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  background-color: rgba(20, 20, 26, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.hint-arrow {
  font-size: 30rpx;
  color: #FFFFFF;
  margin-right: 12rpx;
}

.hint-text {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 1rpx;
}

/* 帧序号 */
.pano-counter {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  padding: 5rpx 16rpx;
  border-radius: 20rpx;
  background-color: rgba(20, 20, 26, 0.55);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}
