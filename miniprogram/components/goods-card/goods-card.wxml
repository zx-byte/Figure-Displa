<!-- components/goods-card/goods-card.wxml -->
<view class="goods-card {{layout === 'list' ? 'goods-card--list' : ''}}" bindtap="goDetail" hover-class="goods-card--hover">
  <view class="thumb-wrap">
    <image
      wx:if="{{!coverBroken}}"
      class="thumb"
      src="{{coverSrc}}"
      mode="aspectFill"
      lazy-load="{{true}}"
      binderror="onCoverError"
    />
    <view wx:else class="thumb thumb--broken">
      <text class="thumb-broken-mark">◇</text>
      <text class="thumb-broken-text">图片加载失败</text>
    </view>
    <view wx:if="{{isPresale}}" class="badge badge--limit">{{typeText}}</view>
    <view wx:elif="{{typeText}}" class="badge">{{typeText}}</view>
    <view wx:if="{{soldOut}}" class="sold-mask">
      <text class="sold-text">已售罄</text>
    </view>
  </view>

  <view class="info">
    <view class="name ellipsis-2">{{item.name}}</view>
    <view wx:if="{{item.subtitle}}" class="subtitle ellipsis">{{item.subtitle}}</view>
    <view class="price-row">
      <text wx:if="{{inquire}}" class="price price--inquire">询价</text>
      <text wx:else class="price"><text class="price-symbol">¥</text><text class="price-value">{{priceText}}</text></text>
      <text wx:if="{{originText}}" class="price-origin">¥{{originText}}</text>
    </view>
    <view wx:if="{{showSold}}" class="sold-line">已售 {{item.soldCount || 0}}</view>
  </view>
</view>
