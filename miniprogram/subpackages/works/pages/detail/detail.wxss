/* pages/detail/detail.wxss */

.page {
  min-height: 100vh;
  background-color: #F5F5F7;
}

/* ---------- 主图 ---------- */

.gallery {
  position: relative;
  width: 100%;
  background-color: #FFFFFF;
}

/* 主图右上角操作组：环视 / 海报 */
.gallery-actions {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.pano-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background-color: rgba(20, 20, 26, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  margin-bottom: 12rpx;
}

.pano-entry:last-child {
  margin-bottom: 0;
}

.pano-entry--hover {
  background-color: rgba(20, 20, 26, 0.82);
}

.pano-icon {
  font-size: 24rpx;
  color: #FF5C39;
  margin-right: 6rpx;
  line-height: 1;
}

.pano-text {
  font-size: 21rpx;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.gallery-swiper {
  width: 100%;
  height: 750rpx;
}

.gallery-img {
  width: 100%;
  height: 750rpx;
  background-color: #F0F0F4;
}

/* 主图加载失败：品牌色渐变占位，与 banner 处理保持一致 */
.gallery-img--broken {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2A2A38 0%, #1A1A24 100%);
}

.gallery-broken-mark {
  font-size: 64rpx;
  color: rgba(255, 255, 255, 0.35);
}

.gallery-broken-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.gallery-counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background-color: rgba(26, 26, 36, 0.55);
  color: #FFFFFF;
  font-size: 22rpx;
}

.gallery-hint {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.86);
  color: #4A4A5A;
  font-size: 20rpx;
}

/* ---------- 信息卡 ---------- */

.info-card {
  margin-top: 16rpx;
  padding: 32rpx 24rpx 28rpx;
  background-color: #FFFFFF;
}

.price-block {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
}

.price-main {
  font-size: 52rpx;
  font-weight: 600;
  color: #FF5C39;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

/* 无标价作品：字号回落到标题级，避免「询价」二字过大 */
.price-main--inquire {
  font-size: 36rpx;
  letter-spacing: 2rpx;
}

.price-symbol {
  font-size: 28rpx;
}

.price-origin {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #B0B0BE;
  text-decoration: line-through;
}

.tag-gold-inline {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background-color: #FBF6E6;
  color: #C9A227;
  font-size: 21rpx;
  font-weight: 500;
}

.tag-inline {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background-color: #FFF0EC;
  color: #FF5C39;
  font-size: 21rpx;
  font-weight: 500;
}

.title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A24;
  line-height: 1.5;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #8A8A9E;
  line-height: 1.5;
}

.meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
}

.meta-stock {
  font-size: 23rpx;
  color: #4A4A5A;
}

.meta-stock--out {
  color: #FF5C39;
}

.meta-sold {
  margin-left: 24rpx;
  font-size: 23rpx;
  color: #8A8A9E;
}

.notice-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 14rpx;
}

.notice-label {
  width: 140rpx;
  font-size: 23rpx;
  color: #8A8A9E;
}

.notice-value {
  font-size: 23rpx;
  color: #4A4A5A;
}

/* ---------- 通用卡片 ---------- */

.block-card {
  margin-top: 16rpx;
  padding: 28rpx 24rpx;
  background-color: #FFFFFF;
}

.block-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A24;
}

/* ---------- 规格 ---------- */

.spec-group {
  margin-top: 24rpx;
}

.spec-name {
  font-size: 24rpx;
  color: #8A8A9E;
  margin-bottom: 14rpx;
}

.spec-options {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.spec-option {
  margin: 0 16rpx 16rpx 0;
  padding: 14rpx 32rpx;
  border-radius: 12rpx;
  border: 1rpx solid #EDEDF2;
  background-color: #FAFAFC;
  font-size: 25rpx;
  color: #4A4A5A;
}

.spec-option--active {
  border-color: #FF5C39;
  background-color: #FFF0EC;
  color: #FF5C39;
  font-weight: 500;
}

/* ---------- 数量 ---------- */

.count-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 1rpx solid #EDEDF2;
  border-radius: 12rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 64rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #1A1A24;
  background-color: #FAFAFC;
}

.stepper-btn--disabled {
  color: #C4C4D0;
}

.stepper-value {
  width: 80rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1A1A24;
}

.count-tip {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #C9A227;
  line-height: 1.6;
}

/* ---------- 详情图文 ---------- */

.detail-img {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 12rpx;
  display: block;
}

.detail-text {
  margin-top: 20rpx;
  font-size: 27rpx;
  color: #4A4A5A;
  line-height: 1.8;
}

/* ---------- 须知 ---------- */

.rule-item {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #8A8A9E;
  line-height: 1.7;
}

/* ---------- 底部操作栏 ---------- */

.bottom-holder {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 16rpx rgba(26, 26, 36, 0.06);
}

.action-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  padding: 0;
  margin: 0;
  background-color: transparent;
  line-height: 1.2;
}

.action-icon--plain::after {
  border: none;
}

.action-symbol {
  font-size: 32rpx;
  color: #4A4A5A;
  line-height: 1.2;
}

.action-symbol--on {
  color: #FF5C39;
}

.action-label {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #8A8A9E;
}

.btn-ghost-bar {
  flex: 1;
  height: 84rpx;
  margin-left: 16rpx;
  border-radius: 42rpx;
  border: 1rpx solid #1A1A24;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: #1A1A24;
}

.btn-primary-bar {
  flex: 1;
  height: 84rpx;
  margin-left: 16rpx;
  border-radius: 42rpx;
  background-color: #FF5C39;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.btn-bar--hover {
  opacity: 0.84;
}

/* 纯展示模式下主按钮由 button 元素承担，需重置其默认边框与内边距 */
.btn-contact-bar {
  border: none;
  padding: 0;
  line-height: 84rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

.btn-contact-bar::after {
  border: none;
}

/* ---------- 尺寸对照 ---------- */

.size-hint {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9C9CAC;
}

.size-chart {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  padding: 34rpx 0 14rpx;
}

.size-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.size-bar-wrap {
  height: 250rpx;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.size-bar {
  width: 46rpx;
  border-radius: 8rpx 8rpx 0 0;
  background-color: #E4E4EC;
}

.size-bar--self {
  width: 58rpx;
  background: linear-gradient(180deg, #FF8A5B 0%, #FF5C39 100%);
}

.size-name {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #8A8A9E;
}

.size-name--self {
  color: #FF5C39;
  font-weight: 600;
}

.size-cm {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: #B0B0BE;
  font-family: 'DIN Alternate', sans-serif;
}

.size-meta {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F7;
  font-size: 21rpx;
  color: #8A8A9E;
  line-height: 1.7;
}

/* ---------- 上色前后对比 ---------- */

.compare-block {
  margin-top: 20rpx;
  padding-top: 32rpx;
  background-color: #FFFFFF;
}

.compare-head {
  padding: 0 32rpx 24rpx;
}

.compare-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9C9CAC;
}

/* ---------- 工序时间轴 ---------- */

.craft-hint {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9C9CAC;
}

.timeline {
  margin-top: 26rpx;
}

.tl-item {
  display: flex;
  flex-direction: row;
}

.tl-axis {
  width: 42rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background-color: #D9D9E0;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.tl-dot--first {
  background-color: #FF5C39;
  box-shadow: 0 0 0 6rpx rgba(255, 92, 57, 0.14);
}

.tl-line {
  flex: 1;
  width: 2rpx;
  min-height: 48rpx;
  margin-top: 8rpx;
  background-color: #EDEDF2;
}

.tl-body {
  flex: 1;
  min-width: 0;
  padding-left: 10rpx;
  padding-bottom: 34rpx;
}

.tl-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}

.tl-stage {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A24;
}

.tl-date {
  font-size: 20rpx;
  color: #B0B0BE;
  font-family: 'DIN Alternate', sans-serif;
}

.tl-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #6A6A7C;
  line-height: 1.6;
}

.tl-meta {
  display: inline-block;
  margin-top: 8rpx;
  padding: 3rpx 14rpx;
  border-radius: 6rpx;
  background-color: #FFF0EC;
  font-size: 19rpx;
  color: #FF5C39;
}

.tl-img {
  width: 100%;
  margin-top: 14rpx;
  border-radius: 12rpx;
  background-color: #F0F0F4;
}

/* ---------- 同系列推荐 ---------- */

.related-block {
  margin-top: 20rpx;
  padding: 26rpx 0 26rpx 24rpx;
  background-color: #FFFFFF;
}

.related-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-right: 24rpx;
}

.related-head-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.sec-bar {
  width: 4rpx;
  height: 28rpx;
  border-radius: 2rpx;
  background-color: #FF5C39;
  margin-right: 12rpx;
}

.related-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A24;
}

.related-more {
  font-size: 21rpx;
  color: #8A8A9E;
}

.related-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.related-inner {
  display: inline-flex;
  flex-direction: row;
  padding-right: 24rpx;
}

.related-item {
  width: 200rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.related-item--hover {
  opacity: 0.85;
}

.related-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #F0F0F4;
}

.related-name {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #1A1A24;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.related-price {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FF5C39;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

/* ---------- 沉浸看图 ---------- */

.viewer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: #000000;
  z-index: 999;
}

.viewer-swiper {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.viewer-area {
  width: 100%;
  height: 100%;
}

.viewer-move {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.viewer-img {
  width: 100%;
  height: 100%;
}

.viewer-close {
  position: absolute;
  top: 96rpx;
  right: 32rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
  font-size: 38rpx;
  line-height: 58rpx;
  text-align: center;
  z-index: 10;
}

.viewer-close--hover {
  background-color: rgba(255, 255, 255, 0.26);
}

.viewer-counter {
  position: absolute;
  top: 106rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.12);
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.82);
  font-family: 'DIN Alternate', sans-serif;
  z-index: 10;
}

.viewer-thumbs {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  white-space: nowrap;
  z-index: 10;
}

.viewer-thumb-inner {
  display: inline-flex;
  flex-direction: row;
  padding: 0 32rpx;
}

.viewer-thumb {
  width: 88rpx;
  height: 88rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
  opacity: 0.5;
  background-color: #22222C;
}

.viewer-thumb--on {
  border-color: #FF5C39;
  opacity: 1;
}
