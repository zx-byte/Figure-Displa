/* pages/about/about.wxss */

.page {
  min-height: 100vh;
  background-color: #F7F7F9;
}

/* ---------- 头图 ---------- */

.hero {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(20, 20, 26, 0.28) 0%, rgba(20, 20, 26, 0.86) 100%);
}

.hero-content {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 48rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.62);
  line-height: 1.6;
}

/* ---------- 数字 ---------- */

.stats {
  display: flex;
  flex-direction: row;
  margin: -36rpx 24rpx 0;
  padding: 36rpx 0;
  border-radius: 20rpx;
  background-color: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(26, 26, 36, 0.06);
  position: relative;
  z-index: 2;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat + .stat {
  border-left: 1rpx solid #F0F0F4;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #1A1A24;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  line-height: 1;
}

.stat-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #FF5C39;
  margin-left: 2rpx;
}

.stat-label {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #8A8A9E;
}

/* ---------- 正文 ---------- */

.block {
  margin: 32rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  background-color: #FFFFFF;
}

.block--tip {
  background-color: transparent;
  padding: 8rpx 32rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A24;
  margin-bottom: 20rpx;
  padding-left: 18rpx;
  position: relative;
}

.block-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 4rpx;
  height: 26rpx;
  border-radius: 2rpx;
  background-color: #FF5C39;
}

.para {
  font-size: 25rpx;
  line-height: 1.85;
  color: #4A4A5C;
  text-align: justify;
}

.para + .para {
  margin-top: 20rpx;
}

.para--muted {
  font-size: 22rpx;
  color: #9C9CAC;
  line-height: 1.8;
}

/* ---------- 联系 ---------- */

.contact-btn {
  margin: 48rpx 24rpx 0;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background-color: #FF5C39;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.contact-btn::after {
  border: none;
}

/* ---------- 协议入口 ---------- */

.legal {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 28rpx 0 4rpx;
}

.legal-link {
  font-size: 24rpx;
  color: var(--color-sub);
}

.legal-sep {
  margin: 0 14rpx;
  font-size: 24rpx;
  color: #C4C4CE;
}

/* ---------- 页脚 ---------- */

.footer {
  margin-top: 56rpx;
  text-align: center;
}

.footer-brand {
  font-size: 24rpx;
  color: #8A8A9E;
  letter-spacing: 4rpx;
}

.footer-sub {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #C4C4CE;
  letter-spacing: 3rpx;
}

.bottom-space {
  height: calc(60rpx + env(safe-area-inset-bottom));
}
