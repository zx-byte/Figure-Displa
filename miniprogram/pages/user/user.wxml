<!-- pages/user/user.wxml -->
<view class="page">

  <!-- 用户信息 -->
  <view class="profile">
    <view class="avatar-wrap" bindtap="openEdit">
      <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="avatar avatar--default">手</view>
    </view>
    <view class="profile-info" bindtap="openEdit">
      <view class="nickname">{{nickname || '点击设置昵称'}}</view>
      <view class="profile-sub">{{phone ? phone : '手作收藏从这里开始'}}</view>
    </view>
    <view class="edit-entry" bindtap="openEdit">编辑</view>
  </view>

  <!-- 订单入口：仅交易模式显示 -->
  <view wx:if="{{showTrade}}" class="card">
    <view class="card-head" data-status="all" bindtap="goOrderList">
      <text class="card-title">我的订单</text>
      <text class="card-more">全部订单 ›</text>
    </view>
    <view class="order-entries">
      <view
        wx:for="{{orderEntries}}"
        wx:key="status"
        class="order-entry"
        data-status="{{item.status}}"
        bindtap="goOrderList"
      >
        <text class="entry-symbol">{{item.symbol}}</text>
        <text class="entry-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 定制：交易模式看进度，展示模式直接聊 -->
  <view class="card">
    <block wx:if="{{showTrade}}">
      <view class="card-head" bindtap="goCustomList">
        <text class="card-title">我的定制</text>
        <text class="card-more">查看进度 ›</text>
      </view>
      <view class="custom-tip">定制作品从下单到完工，每个节点都可查看</view>
      <view class="custom-btn" bindtap="goCustomApply" hover-class="custom-btn--hover">提交新的定制需求</view>
    </block>

    <block wx:else>
      <view class="card-head">
        <text class="card-title">专属定制</text>
      </view>
      <view class="custom-tip">
        想要独一份的作品？把你的想法告诉我们——角色设定、比例、配色、底座样式都可以聊。
      </view>
      <button class="custom-btn custom-btn--contact" open-type="contact">
        微信咨询定制
      </button>
    </block>
  </view>

  <!-- 功能列表 -->
  <view class="menu">
    <view class="menu-item" bindtap="goFavorite">
      <text class="menu-label">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goHistory">
      <text class="menu-label">浏览历史</text>
      <text class="menu-arrow">›</text>
    </view>
    <view wx:if="{{showTrade}}" class="menu-item" bindtap="goAddress">
      <text class="menu-label">收货地址</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goVerify">
      <text class="menu-label">作品编号查询</text>
      <text class="menu-arrow">›</text>
    </view>
    <button class="menu-item menu-item--button" open-type="contact">
      <text class="menu-label">联系手作人</text>
      <text class="menu-arrow">›</text>
    </button>
    <view class="menu-item" bindtap="goAbout">
      <text class="menu-label">关于</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPrivacy">
      <text class="menu-label">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goTerms">
      <text class="menu-label">用户协议</text>
      <text class="menu-arrow">›</text>
    </view>
    <view wx:if="{{isAdmin}}" class="menu-item" bindtap="goAdmin">
      <text class="menu-label">商家管理后台</text>
      <text class="menu-tag">管理员</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer-tip">手作不易，每一件都值得被认真对待</view>

  <!-- 资料编辑弹层 -->
  <view wx:if="{{editVisible}}" class="mask" bindtap="closeEdit">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">编辑个人资料</view>

      <view class="sheet-row">
        <text class="sheet-label">头像</text>
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{editAvatar}}" class="sheet-avatar" src="{{editAvatar}}" mode="aspectFill" />
          <view wx:else class="sheet-avatar sheet-avatar--default">选择</view>
        </button>
      </view>

      <view class="sheet-row">
        <text class="sheet-label">昵称</text>
        <input
          class="sheet-input"
          type="nickname"
          value="{{editNickname}}"
          placeholder="请输入昵称"
          placeholder-class="sheet-ph"
          maxlength="20"
          bindinput="onNicknameInput"
        />
      </view>

      <view class="sheet-actions">
        <view class="sheet-btn sheet-btn--ghost" bindtap="closeEdit">取消</view>
        <view class="sheet-btn sheet-btn--primary" bindtap="onSaveProfile">
          {{saving ? '保存中…' : '保存'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 未同意协议时的确认弹窗 -->
  <privacy-modal
    show="{{privacyShow}}"
    bind:agree="onPrivacyAgree"
    bind:disagree="onPrivacyDisagree"
  />

</view>
