/* pages/user/user.wxss */

.page {
  min-height: 100vh;
  background-color: #F5F5F7;
  padding-bottom: 60rpx;
}

/* ---------- 用户信息 ---------- */

.profile {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 48rpx 32rpx 56rpx;
  background: linear-gradient(135deg, #1A1A24 0%, #33334A 100%);
}

.avatar-wrap {
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.12);
}

.avatar--default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.72);
}

.profile-info {
  flex: 1;
  min-width: 0;
  padding-left: 24rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.56);
}

.edit-entry {
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

/* ---------- 卡片 ---------- */

.card {
  margin: -28rpx 24rpx 0;
  padding: 28rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  position: relative;
}

.card + .card {
  margin-top: 20rpx;
}

.card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A24;
}

.card-more {
  font-size: 23rpx;
  color: #8A8A9E;
}

/* ---------- 订单入口 ---------- */

.order-entries {
  display: flex;
  flex-direction: row;
  padding-top: 28rpx;
}

.order-entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entry-symbol {
  font-size: 36rpx;
  color: #1A1A24;
  line-height: 1.2;
}

.entry-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #4A4A5A;
}

/* ---------- 定制 ---------- */

.custom-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8A8A9E;
  line-height: 1.6;
}

.custom-btn {
  margin-top: 22rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: #1A1A24;
  color: #FFFFFF;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-btn--hover {
  opacity: 0.86;
}

/* 纯展示模式下按钮由 button 元素承担，需重置默认样式 */
.custom-btn--contact {
  border: none;
  padding: 0;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: 400;
}

.custom-btn--contact::after {
  border: none;
}

/* ---------- 功能列表 ---------- */

.menu {
  margin: 20rpx 24rpx 0;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 104rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #F5F5F7;
  background-color: #FFFFFF;
  border-radius: 0;
  line-height: 1.4;
  font-size: 27rpx;
  text-align: left;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item--button::after {
  border: none;
}

/* 整行按压反馈。列表里既有 view 项也有 button 项（客服），
   统一用同一个 hover-class，避免只有客服那行点下去有反应 */
.menu-item--hover {
  background-color: #FAFAFC;
}

.menu-label {
  flex: 1;
  font-size: 27rpx;
  color: #1A1A24;
}

.menu-tag {
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background-color: #FFF0EC;
  color: #FF5C39;
  font-size: 19rpx;
}

.menu-arrow {
  font-size: 30rpx;
  color: #C4C4D0;
}

.footer-tip {
  margin-top: 56rpx;
  text-align: center;
  font-size: 21rpx;
  color: #B0B0BE;
  letter-spacing: 2rpx;
}

/* ---------- 编辑弹层 ---------- */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
}

.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A24;
  margin-bottom: 32rpx;
}

.sheet-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #F5F5F7;
}

.sheet-label {
  width: 120rpx;
  font-size: 27rpx;
  color: #1A1A24;
}

.avatar-btn {
  margin: 0;
  padding: 0;
  background-color: transparent;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.sheet-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background-color: #F0F0F4;
}

.sheet-avatar--default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #8A8A9E;
}

.sheet-input {
  flex: 1;
  font-size: 27rpx;
  color: #1A1A24;
}

.sheet-ph {
  color: #B0B0BE;
}

.sheet-actions {
  display: flex;
  flex-direction: row;
  margin-top: 36rpx;
}

.sheet-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 500;
}

.sheet-btn--ghost {
  background-color: #F5F5F7;
  color: #4A4A5A;
  margin-right: 20rpx;
}

.sheet-btn--primary {
  background-color: #FF5C39;
  color: #FFFFFF;
}
