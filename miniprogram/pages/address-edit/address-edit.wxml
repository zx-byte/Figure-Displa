<!-- pages/address-edit/address-edit.wxml -->
<view class="page">

  <view class="form-card">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input
        class="form-input"
        value="{{name}}"
        placeholder="请填写姓名"
        placeholder-class="ph"
        maxlength="20"
        bindinput="onNameInput"
      />
    </view>

    <view class="form-row">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        value="{{phone}}"
        type="number"
        placeholder="请填写 11 位手机号"
        placeholder-class="ph"
        maxlength="11"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-row">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="form-picker">
          <text wx:if="{{regionText}}">{{regionText}}</text>
          <text wx:else class="ph">请选择省 / 市 / 区</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-row form-row--textarea">
      <text class="form-label">详细地址</text>
      <textarea
        class="form-textarea"
        value="{{detail}}"
        placeholder="街道、门牌号、楼层等"
        placeholder-class="ph"
        maxlength="100"
        bindinput="onDetailInput"
        auto-height="{{true}}"
      />
    </view>
  </view>

  <view class="form-card">
    <view class="form-row form-row--switch">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{isDefault}}" color="#FF5C39" bindchange="onDefaultChange" />
    </view>
  </view>

  <view class="tips">手工作品多为易碎品，请填写可正常签收的地址</view>

  <view class="bottom-holder"></view>

  <view class="bottom-bar">
    <view class="save-btn {{saving ? 'save-btn--disabled' : ''}}" bindtap="onSave" hover-class="save-btn--hover">
      {{saving ? '保存中…' : '保存地址'}}
    </view>
  </view>

</view>
