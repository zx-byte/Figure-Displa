/* pages/admin/product/product.wxss */

.page {
  min-height: 100vh;
  background-color: #F5F5F7;
}

/* ---------- 头部 ---------- */

.head {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: #FFFFFF;
  padding: 20rpx 24rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(26, 26, 36, 0.04);
}

.search-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.search-box {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 36rpx;
  background-color: #F5F5F7;
}

.search-icon {
  font-size: 30rpx;
  color: #8A8A9E;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A24;
}

.ph {
  color: #B0B0BE;
}

.search-btn {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #FF5C39;
}

.tabs {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0 0;
}

.tab {
  margin-right: 36rpx;
  padding-bottom: 14rpx;
  font-size: 26rpx;
  color: #8A8A9E;
  position: relative;
}

.tab--active {
  color: #1A1A24;
  font-weight: 600;
}

.tab--active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background-color: #FF5C39;
}

.total-text {
  margin-left: auto;
  font-size: 21rpx;
  color: #9C9CAC;
}

/* ---------- 列表 ---------- */

.list-wrap {
  padding: 20rpx 24rpx 0;
}

.product-card {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
}

.card-main {
  display: flex;
  flex-direction: row;
}

.cover {
  width: 170rpx;
  height: 170rpx;
  border-radius: 16rpx;
  background-color: #F0F0F4;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.name {
  font-size: 27rpx;
  font-weight: 500;
  color: #1A1A24;
  line-height: 1.45;
}

.meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
}

.tag {
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
}

.tag--on {
  background-color: #E8F5E9;
  color: #00897B;
}

.tag--off {
  background-color: #F0F0F4;
  color: #8A8A9E;
}

.type-text {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #9C9CAC;
}

.price-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-top: 10rpx;
}

.price {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A24;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.stock {
  margin-left: 18rpx;
  font-size: 21rpx;
  color: #8A8A9E;
}

.sold {
  margin-left: 14rpx;
  font-size: 21rpx;
  color: #8A8A9E;
}

.card-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F7;
}

.act {
  margin-left: 16rpx;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid #EDEDF2;
  font-size: 23rpx;
  color: #4A4A5A;
}

.act--primary {
  border-color: #FF5C39;
  color: #FF5C39;
}

.act--danger {
  border-color: #EDEDF2;
  color: #8A8A9E;
}

.load-more {
  padding: 24rpx 0 40rpx;
  text-align: center;
  font-size: 23rpx;
  color: #B0B0BE;
}

/* ---------- 底部 ---------- */

.bottom-holder {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 16rpx rgba(26, 26, 36, 0.06);
}

.add-btn {
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #FF5C39;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn--hover {
  opacity: 0.84;
}

/* ---------- 批量操作 ---------- */

.multi-toggle {
  margin-left: 16rpx;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid #D9D9E0;
  font-size: 23rpx;
  color: #4A4A5A;
  flex-shrink: 0;
}

.product-card--multi {
  position: relative;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #D0D0DA;
  margin-right: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  background-color: #FFFFFF;
  align-self: center;
}

.check--on {
  background-color: #FF5C39;
  border-color: #FF5C39;
}

.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 16rpx rgba(26, 26, 36, 0.08);
  z-index: 20;
}

.batch-left {
  display: flex;
  align-items: center;
}

.batch-count {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #4A4A5A;
}

.batch-actions {
  display: flex;
  gap: 14rpx;
}

.batch-btn {
  padding: 14rpx 26rpx;
  border-radius: 32rpx;
  border: 1rpx solid #D9D9E0;
  font-size: 24rpx;
  color: #4A4A5A;
}

.batch-btn--primary {
  background-color: #FF5C39;
  border-color: #FF5C39;
  color: #FFFFFF;
  font-weight: 500;
}
