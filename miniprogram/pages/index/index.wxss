/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  background-color: #F5F5F7;
  padding-bottom: 48rpx;
}

/* ---------- 自定义导航栏 ---------- */

.nav {
  background-color: #F5F5F7;
}

.nav-bar {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.nav-brand {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #1A1A24;
}

.nav-slogan {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #A8A8B8;
}

/* ---------- 搜索栏 ---------- */

.search-bar {
  padding: 12rpx 24rpx 12rpx;
  background-color: #F5F5F7;
}

.search-input {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background-color: #FFFFFF;
}

.search-input--hover {
  background-color: #F0F0F4;
}

.search-icon {
  font-size: 32rpx;
  color: #8A8A9E;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #A8A8B8;
}

/* ---------- 轮播 ---------- */

.banner {
  height: 480rpx;
  margin: 12rpx 24rpx 0;
  border-radius: 32rpx;
  overflow: hidden;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
}

/* 轮播图加载失败：品牌色渐变块，配合下方遮罩文字仍可读 */
.banner-img--broken {
  background: linear-gradient(135deg, #2A2A38 0%, #1A1A24 100%);
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.62) 100%);
}

.banner-text {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 40rpx;
}

.banner-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.banner-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}

/* ---------- 分类入口 ---------- */

.entry-row {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  padding: 36rpx 20rpx 8rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
  transition: transform 0.15s ease;
}

.entry-item--hover {
  transform: scale(0.94);
}

.entry-dot {
  width: 92rpx;
  height: 92rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(26, 26, 36, 0.12);
}

.entry-symbol {
  font-size: 34rpx;
  color: #FFFFFF;
}

.entry-label {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #4A4A5A;
}

/* ---------- 通用板块 ---------- */

.block {
  margin-top: 44rpx;
  padding: 0 24rpx;
}

/* ---------- 限量专区 ---------- */

.presale-scroll {
  white-space: nowrap;
}

.presale-track {
  display: flex;
  flex-direction: row;
  padding-bottom: 8rpx;
}

.presale-item {
  width: 300rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.presale-thumb-wrap {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  background-color: #F0F0F4;
}

.presale-thumb {
  width: 300rpx;
  height: 300rpx;
}

.presale-badge {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  background-color: #C9A227;
  color: #FFFFFF;
}

.presale-name {
  padding: 16rpx 18rpx 0;
  font-size: 25rpx;
  color: #1A1A24;
}

.presale-price {
  padding: 8rpx 18rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FF5C39;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

/* ---------- 定制入口 ---------- */

.custom-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 44rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(120deg, #1A1A24 0%, #33334A 100%);
}

.custom-card--hover {
  opacity: 0.92;
}

/* 纯展示模式下定制卡片由 button 元素承担，需重置默认边框与内边距 */
.custom-card--contact {
  border: none;
  padding: 36rpx 32rpx;
  line-height: normal;
  text-align: left;
  font-size: 30rpx;
  font-weight: 400;
}

.custom-card--contact::after {
  border: none;
}

.custom-left {
  flex: 1;
  min-width: 0;
}

.custom-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.custom-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.66);
}

.custom-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  background-color: #FF5C39;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 500;
}

/* ---------- 商品网格 ---------- */

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-cell {
  width: 48.5%;
  margin-bottom: 20rpx;
}

/* ---------- 页脚 ---------- */

.footer-tip {
  margin-top: 56rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B0B0BE;
  letter-spacing: 2rpx;
}
