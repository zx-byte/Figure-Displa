/* pages/custom-apply/custom-apply.wxss */

.page {
  min-height: 100vh;
  background-color: #F5F5F7;
  padding-bottom: 20rpx;
}

/* ---------- 说明头 ---------- */

.hero {
  padding: 40rpx 32rpx 44rpx;
  background: linear-gradient(135deg, #1A1A24 0%, #33334A 100%);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.62);
  line-height: 1.7;
}

/* ---------- 表单 ---------- */

.form-card {
  margin: 20rpx 24rpx 0;
  padding: 0 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
}

.form-card:first-of-type {
  margin-top: -20rpx;
}

.form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #F5F5F7;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row--stack {
  flex-direction: column;
  align-items: flex-start;
  padding: 28rpx 0;
}

.form-label {
  width: 190rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #1A1A24;
}

.form-label--block {
  width: auto;
  padding: 28rpx 0 0;
}

.form-input {
  flex: 1;
  width: 100%;
  font-size: 27rpx;
  color: #1A1A24;
  padding: 12rpx 0;
}

.form-picker {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  color: #1A1A24;
}

.picker-arrow {
  font-size: 30rpx;
  color: #C4C4D0;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  margin-top: 12rpx;
  font-size: 27rpx;
  color: #1A1A24;
  line-height: 1.65;
}

.ph {
  color: #B0B0BE;
}

.count-hint {
  align-self: flex-end;
  font-size: 20rpx;
  color: #C4C4D0;
}

/* ---------- 参考图 ---------- */

.image-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 20rpx 0 28rpx;
}

.image-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #F0F0F4;
}

.image-thumb {
  width: 150rpx;
  height: 150rpx;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 0 0 0 16rpx;
  background-color: rgba(26, 26, 36, 0.6);
  color: #FFFFFF;
  font-size: 26rpx;
}

.image-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  border: 1rpx dashed #D9D9E0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FAFAFC;
}

.add-icon {
  font-size: 36rpx;
  color: #B0B0BE;
  line-height: 1;
}

.add-text {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #B0B0BE;
}

/* ---------- 定金 ---------- */

.deposit-card {
  margin: 20rpx 24rpx 0;
  padding: 26rpx 24rpx;
  background-color: #FBF6E6;
  border-radius: 24rpx;
}

.deposit-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}

.deposit-label {
  font-size: 25rpx;
  color: #8A6D1F;
}

.deposit-value {
  font-size: 38rpx;
  font-weight: 600;
  color: #C9A227;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.deposit-note {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #A8892F;
  line-height: 1.7;
}

/* ---------- 协议声明 ---------- */

.agree-tip {
  padding: 24rpx 24rpx 0;
  font-size: 23rpx;
  line-height: 1.8;
  color: var(--color-sub);
  text-align: center;
}

.agree-link {
  color: var(--color-brand);
}

/* ---------- 底部 ---------- */

.bottom-holder {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 16rpx rgba(26, 26, 36, 0.06);
}

.submit-btn {
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #FF5C39;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn--disabled {
  background-color: #D9D9E0;
}

.submit-btn--hover {
  opacity: 0.84;
}
