/* pages/panorama/panorama.wxss */

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: #14141A;
  overflow: hidden;
}

.pano-wrap {
  width: 100%;
  height: 100%;
}

.loading-tip,
.empty-tip {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* ---------- 顶部 ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-left: 16rpx;
  padding-right: 16rpx;
  padding-bottom: 12rpx;
  background: linear-gradient(180deg, rgba(20, 20, 26, 0.72) 0%, rgba(20, 20, 26, 0) 100%);
  z-index: 10;
}

.close-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background-color: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 60rpx;
  text-align: center;
  flex-shrink: 0;
}

.close-btn--hover {
  background-color: rgba(255, 255, 255, 0.2);
}

.top-title {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 底部 ---------- */

.bottom-tip {
  position: fixed;
  left: 50%;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background-color: rgba(255, 255, 255, 0.08);
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 1rpx;
}

.tip-dot {
  font-size: 14rpx;
  color: #FF5C39;
  margin-right: 10rpx;
}
