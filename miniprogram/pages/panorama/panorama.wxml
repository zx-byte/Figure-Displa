<!-- pages/panorama/panorama.wxml -->
<view class="page">

  <view class="pano-wrap">
    <panorama wx:if="{{frames.length > 0}}" frames="{{frames}}" />
    <view wx:elif="{{loading}}" class="loading-tip">加载中…</view>
    <view wx:else class="empty-tip">暂无 360° 视图</view>
  </view>

  <!-- 自定义导航 -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="close-btn" bindtap="onClose" hover-class="close-btn--hover">‹</view>
    <view class="top-title">{{name}}</view>
  </view>

  <!-- 底部说明 -->
  <view wx:if="{{frames.length > 0}}" class="bottom-tip">
    <text class="tip-dot">●</text>
    <text>拖动旋转 · 松手自动滑行</text>
  </view>

</view>
