/* pages/cart/cart.wxss */

.page {
  min-height: 100vh;
  background-color: #F5F5F7;
}

.head-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 8rpx;
}

.head-count {
  font-size: 24rpx;
  color: #8A8A9E;
}

.head-edit {
  font-size: 25rpx;
  color: #1A1A24;
}

.list {
  padding: 12rpx 20rpx 0;
}

.cart-item {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 20rpx;
  margin-bottom: 16rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
}

.cart-item--invalid {
  opacity: 0.55;
}

/* 勾选框 */
.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid #D9D9E0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 18rpx;
}

.check--on {
  background-color: #FF5C39;
  border-color: #FF5C39;
}

.check-mark {
  font-size: 22rpx;
  color: #FFFFFF;
  line-height: 1;
}

.item-cover {
  width: 176rpx;
  height: 176rpx;
  border-radius: 16rpx;
  background-color: #F0F0F4;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 176rpx;
}

.item-name {
  font-size: 27rpx;
  color: #1A1A24;
  line-height: 1.45;
  font-weight: 500;
}

.item-spec {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8A8A9E;
}

.item-invalid {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #FF5C39;
}

.item-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF5C39;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.price-symbol {
  font-size: 22rpx;
}

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 1rpx solid #EDEDF2;
  border-radius: 10rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 52rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1A1A24;
  background-color: #FAFAFC;
}

.stepper-value {
  width: 68rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #1A1A24;
}

.item-remove {
  position: absolute;
  right: 20rpx;
  top: 22rpx;
  font-size: 22rpx;
  color: #FF5C39;
}

.clear-invalid {
  margin: 8rpx 24rpx 0;
  text-align: right;
  font-size: 22rpx;
  color: #8A8A9E;
}

/* ---------- 结算栏 ---------- */

.bottom-holder {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.settle-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 16rpx rgba(26, 26, 36, 0.06);
}

.settle-all {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.settle-all-text {
  font-size: 24rpx;
  color: #4A4A5A;
}

.settle-total {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: flex-end;
  padding-right: 20rpx;
}

.settle-label {
  font-size: 23rpx;
  color: #8A8A9E;
  margin-right: 8rpx;
}

.settle-price {
  font-size: 38rpx;
  font-weight: 600;
  color: #FF5C39;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.settle-btn {
  width: 220rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #FF5C39;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settle-btn--disabled {
  background-color: #D9D9E0;
}

.settle-btn--hover {
  opacity: 0.84;
}
