/* pages/order-list/order-list.wxss */

.page {
  min-height: 100vh;
  background-color: #F5F5F7;
}

/* ---------- 状态筛选 ---------- */

.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: row;
  background-color: #FFFFFF;
  padding: 0 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(26, 26, 36, 0.04);
}

.tab {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8A8A9E;
  position: relative;
}

.tab--active {
  color: #1A1A24;
  font-weight: 600;
}

.tab--active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 44rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background-color: #FF5C39;
}

/* ---------- 订单卡片 ---------- */

.list-wrap {
  padding: 20rpx 24rpx 40rpx;
}

.order-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
}

.order-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #F5F5F7;
}

.order-no {
  font-size: 22rpx;
  color: #9C9CAC;
}

.order-status {
  font-size: 24rpx;
  font-weight: 500;
  color: #FF5C39;
}

.status-1,
.status-2 {
  color: #1565C0;
}

.status-3 {
  color: #4A4A5A;
}

.status--1 {
  color: #9C9CAC;
}

.status-4 {
  color: #C9A227;
}

/* ---------- 商品 ---------- */

.goods-list {
  padding: 18rpx 0 4rpx;
}

.goods-item {
  display: flex;
  flex-direction: row;
  margin-bottom: 16rpx;
}

.goods-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  background-color: #F0F0F4;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.goods-name {
  font-size: 26rpx;
  color: #1A1A24;
  line-height: 1.45;
}

.goods-spec {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8A8A9E;
}

.goods-limit {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #C9A227;
}

.goods-price-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.goods-price {
  font-size: 25rpx;
  color: #1A1A24;
}

.goods-count {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8A8A9E;
}

.more-tip {
  text-align: right;
  font-size: 21rpx;
  color: #9C9CAC;
}

/* ---------- 底部 ---------- */

.order-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 0;
  border-top: 1rpx solid #F5F5F7;
}

.foot-left {
  display: flex;
  flex-direction: column;
}

.foot-count {
  font-size: 22rpx;
  color: #8A8A9E;
}

.foot-countdown {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #FF5C39;
}

.foot-amount {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.foot-label {
  font-size: 22rpx;
  color: #8A8A9E;
  margin-right: 6rpx;
}

.foot-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A24;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.price-symbol {
  font-size: 22rpx;
}

/* ---------- 操作按钮 ---------- */

.actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  padding-top: 18rpx;
}

.btn {
  margin-left: 16rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}

.btn-line {
  border: 1rpx solid #D9D9E0;
  color: #4A4A5A;
}

.btn-fill {
  background-color: #FF5C39;
  color: #FFFFFF;
}

.load-more {
  padding: 28rpx 0 40rpx;
  text-align: center;
  font-size: 23rpx;
  color: #B0B0BE;
}
